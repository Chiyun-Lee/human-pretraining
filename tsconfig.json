{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "supabase/functions/summarise/claude.ts",
    "supabase/functions/slide/claude.ts",
    "supabase/functions/add-paper/resolve.ts",
    "supabase/functions/_shared/refused.ts",
    "supabase/functions/add-paper/find.ts",
    "supabase/functions/_shared/brief.ts"
  ]
}
